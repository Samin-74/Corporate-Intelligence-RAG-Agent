# Edge RAG Agent Configuration
# Copy this file to .env and customize as needed

# LLM Backend: llama_cpp or ollama
LLM_BACKEND=llama_cpp

# Model path (for llama_cpp backend)
LLM_MODEL_PATH=models/Phi-4-mini-instruct-Q4_K_M.gguf

# GPU settings
# Number of layers to offload to GPU (0 = CPU only, -1 = all layers)
N_GPU_LAYERS=-1

# Model context window
N_CTX=4096

# Generation settings
TEMPERATURE=0.1
MAX_TOKENS=1024
REPEAT_PENALTY=1.15

# Retrieval settings
RETRIEVAL_TOP_K=25
RERANK_TOP_N=8

# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Device (cuda or cpu)
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu

# PDF Processing
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# Streamlit settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=200
